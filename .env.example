# OmniTrack local development environment.
# Copy to .env and adjust. Never commit .env. Every value below is a local-only placeholder.

NODE_ENV=development

# --- PostgreSQL (infra/compose.yml, host port 15432) ---
# Migrator role: owns the schema, used only by `npm run db:migrate`.
DATABASE_URL=postgresql://omnitrack_migrator:dev_migrator_pw@localhost:15432/omnitrack
# Application role: DML only, subject to row-level security. Used by the API.
DATABASE_URL_APP=postgresql://omnitrack_app:dev_app_pw@localhost:15432/omnitrack
# Worker role: outbox relay and scheduled jobs.
DATABASE_URL_WORKER=postgresql://omnitrack_worker:dev_worker_pw@localhost:15432/omnitrack

# --- Redis (host port 16379) ---
REDIS_URL=redis://localhost:16379

# --- API ---
API_PORT=4100
WEB_ORIGIN=http://localhost:3100
PORTAL_ORIGIN=http://localhost:3200
COOKIE_SECURE=false
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
SELF_SERVICE_SIGNUP=true
MFA_ENFORCE_PRIVILEGED=true
# Check new passwords against the Have I Been Pwned range API (k-anonymity). Off for offline development.
HIBP_ENABLED=false

# --- Worker / email (Mailpit: SMTP 11025, web UI http://localhost:18025) ---
SMTP_URL=smtp://localhost:11025
EMAIL_FROM=OmniTrack <no-reply@omnitrack.local>
APP_BASE_URL=http://localhost:3100

# --- Web and portal (server side only; the browser calls the API through the Next.js /api rewrite) ---
API_INTERNAL_URL=http://localhost:4100
