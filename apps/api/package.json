{
  "name": "@omnitrack/api",
  "version": "0.0.0",
  "private": true,
  "description": "OmniTrack REST API (NestJS)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --project unit",
    "test:integration": "dotenv -e ../../.env -- vitest run --project integration"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@node-rs/argon2": "2.2.2",
    "@omnitrack/contracts": "*",
    "@omnitrack/db": "*",
    "@omnitrack/permissions": "*",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "otplib": "12.0.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.11",
    "@omnitrack/config": "*",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "8.0.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
