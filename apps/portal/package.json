  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.29",
    "@omnitrack/config": "*",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "dotenv-cli": "8.0.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19"
  }
