  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/eslint-plugin-next": "15.5.29",
    "@omnitrack/config": "*",
    "@playwright/test": "1.65.1",
    "@types/node": "20.19.43",
    "@types/qrcode": "1.5.6",
