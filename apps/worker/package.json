{
  "name": "@omnitrack/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker: outbox relay, email delivery, scheduled jobs (BullMQ)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@omnitrack/db": "*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "nodemailer": "6.10.1",
    "pino": "9.14.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@omnitrack/config": "*",
    "@types/node": "20.19.43",
    "@types/nodemailer": "6.4.24",
    "dotenv-cli": "8.0.0",
    "tsx": "4.23.15",
    "vitest": "3.2.7"
  }
}
