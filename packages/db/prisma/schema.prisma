// OmniTrack database schema. Conventions: docs/DATABASE.md.
// Tenant-owned tables carry organization_id and are protected by PostgreSQL row-level
// security (policies live in the migration SQL, which Prisma cannot express).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  pending_verification
  active
  disabled

  @@map("user_status")
}

enum PlatformRole {
  none
  super_admin

  @@map("platform_role")
}

enum SessionStatus {
  mfa_pending
  active

  @@map("session_status")
}

enum EmailTokenPurpose {
  email_verification
  password_reset

  @@map("email_token_purpose")
}

enum LoginOutcome {
  success
  invalid_credentials
  throttled
  unverified
  disabled
  mfa_required
  mfa_success
  mfa_failure
  no_active_membership

  @@map("login_outcome")
}

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

enum MembershipStatus {
  active
  deactivated

  @@map("membership_status")
}

enum InvitationStatus {
  pending
  accepted
  revoked

  @@map("invitation_status")
}

enum PermissionScope {
  own
  team
  department
  organization

  @@map("permission_scope")
}

enum EmployeeStatus {
  pre_joining
  active
  notice_period
  exited
  cancelled

  @@map("employee_status")
}

enum EmploymentType {
  full_time
  part_time
  contract
  intern

  @@map("employment_type")
}

enum RecordStatus {
  active
  archived

  @@map("record_status")
}

enum AuditCategory {
  security
  business
  admin

  @@map("audit_category")
}

enum AuditOutcome {
  success
  failure

  @@map("audit_outcome")
}

enum OutboxStatus {
  pending
  enqueued
  done
  failed

  @@map("outbox_status")
}

// ──────────────────────── Global (no tenant) ────────────────────────

model User {
  id                String       @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased; a check constraint enforces it.
  email             String       @unique
  displayName       String       @map("display_name")
  passwordHash      String       @map("password_hash")
  status            UserStatus   @default(pending_verification)
  platformRole      PlatformRole @default(none) @map("platform_role")
  emailVerifiedAt   DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  /// TOTP secret, AES-256-GCM encrypted with MFA_ENCRYPTION_KEY.
  mfaSecretEnc      String?      @map("mfa_secret_enc")
  mfaEnabledAt      DateTime?    @map("mfa_enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step; a code can never be used twice (replay protection).
  mfaLastUsedStep   Int?         @map("mfa_last_used_step")
  passwordChangedAt DateTime     @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?    @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  emailTokens   EmailToken[]
  recoveryCodes MfaRecoveryCode[]
  memberships   Membership[]

  @@map("users")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Server-side session. The browser holds only an opaque random token in an HttpOnly cookie;
/// this table stores its SHA-256 hash (ADR-012).
model Session {
  id                String        @id @default(uuid(7)) @db.Uuid
  tokenHash         String        @unique @map("token_hash")
  userId            String        @map("user_id") @db.Uuid
  organizationId    String?       @map("organization_id") @db.Uuid
  membershipId      String?       @map("membership_id") @db.Uuid
  status            SessionStatus @default(active)
  ip                String?
  userAgent         String?       @map("user_agent")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime      @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime      @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?     @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?       @map("revoked_reason")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([organizationId, revokedAt])
  @@index([membershipId])
  @@map("sessions")
}

model EmailToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?         @map("used_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

/// Security log of every sign-in attempt (login history, lockout). Append-only for the app role.
model LoginEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  email          String
  organizationId String?      @map("organization_id") @db.Uuid
  outcome        LoginOutcome
  ip             String?
  userAgent      String?      @map("user_agent")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@map("login_events")
}

/// The tenant root. Not itself under RLS: the application only reads organizations the
/// session's membership points to, or (platform admins) lists them.
model Organization {
  id              String             @id @default(uuid(7)) @db.Uuid
  name            String
  /// Globally unique, [a-z0-9-], used in public URLs.
  slug            String             @unique
  status          OrganizationStatus @default(active)
  timezone        String             @default("UTC")
  locale          String             @default("en-IN")
  currency        String             @default("INR") @db.Char(3)
  /// ISO weekdays (1 = Monday … 7 = Sunday) on which daily reports are expected.
  workingDays     Int[]              @default([1, 2, 3, 4, 5]) @map("working_days")
  /// Local time (HH:MM) on the next working day after which a daily report counts as late.
  reportCutoff    String             @default("10:00") @map("report_cutoff")
  suspendedAt     DateTime?          @map("suspended_at") @db.Timestamptz(3)
  createdByUserId String?            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int                @default(1)

  sessions Session[]

  @@map("organizations")
}

/// Transactional outbox (ADR-011). Not under RLS: the app role may only INSERT, the worker
/// role may only SELECT and UPDATE. Payloads containing secrets are redacted after delivery.
model OutboxEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  type           String
  payload        Json
  status         OutboxStatus @default(pending)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_events")
}

// ──────────────────────── Tenant-owned (RLS) ────────────────────────

model Membership {
  id                 String           @id @default(uuid(7)) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  employeeId         String           @map("employee_id") @db.Uuid
  status             MembershipStatus @default(active)
  /// Bumped whenever this member's roles change; used to invalidate permission caches.
  permissionsVersion Int              @default(1) @map("permissions_version")
  deactivatedAt      DateTime?        @map("deactivated_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  roles    MembershipRole[]

  @@unique([organizationId, userId])
  @@unique([employeeId])
  @@index([userId])
  @@map("memberships")
}

model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Built-in key (e.g. org_owner) or a slug for custom roles.
  key            String
  name           String
  description    String   @default("")
  /// Built-in roles take their grants from code (packages/permissions) and are immutable.
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int      @default(1)

  permissions RolePermission[]
  members     MembershipRole[]

  @@unique([organizationId, key])
  @@map("roles")
}

model RolePermission {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  roleId         String          @map("role_id") @db.Uuid
  permission     String
  scope          PermissionScope

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([organizationId])
  @@map("role_permissions")
}

model MembershipRole {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([membershipId, roleId])
  @@index([organizationId, roleId])
  @@map("membership_roles")
}

model Invitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String
  tokenHash        String           @unique @map("token_hash")
  roleId           String           @map("role_id") @db.Uuid
  /// Invite an existing employee record to sign in (instead of creating a new one).
  employeeId       String?          @map("employee_id") @db.Uuid
  status           InvitationStatus @default(pending)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(3)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, status])
  @@map("invitations")
}

model Department {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  code           String
  description    String       @default("")
  parentId       String?      @map("parent_id") @db.Uuid
  headEmployeeId String?      @map("head_employee_id") @db.Uuid
  status         RecordStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int          @default(1)

  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Department[] @relation("DepartmentTree")
  head      Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: Restrict)
  employees Employee[]   @relation("EmployeeDepartment")
  teams     Team[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@map("departments")
}

model Team {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  departmentId     String       @map("department_id") @db.Uuid
  name             String
  description      String       @default("")
  leaderEmployeeId String       @map("leader_employee_id") @db.Uuid
  status           RecordStatus @default(active)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int          @default(1)

  department Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  leader     Employee     @relation("TeamLeader", fields: [leaderEmployeeId], references: [id], onDelete: Restrict)
  members    TeamMember[]

  @@unique([organizationId, departmentId, name])
  @@index([organizationId, leaderEmployeeId])
  @@map("teams")
}

model TeamMember {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([teamId, employeeId])
  @@index([organizationId, employeeId])
  @@map("team_members")
}

model Employee {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  employeeCode   String         @map("employee_code")
  firstName      String         @map("first_name")
  lastName       String         @default("") @map("last_name")
  /// Lower-cased. Unique per organization when present.
  workEmail      String?        @map("work_email")
  phone          String?
  jobTitle       String         @default("") @map("job_title")
  departmentId   String?        @map("department_id") @db.Uuid
  managerId      String?        @map("manager_id") @db.Uuid
  employmentType EmploymentType @default(full_time) @map("employment_type")
  status         EmployeeStatus @default(active)
  joinDate       DateTime?      @map("join_date") @db.Date
  exitDate       DateTime?      @map("exit_date") @db.Date
  location       String         @default("")
  createdBy      String?        @map("created_by") @db.Uuid
  updatedBy      String?        @map("updated_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int            @default(1)

  department      Department?       @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  manager         Employee?         @relation("ReportingLine", fields: [managerId], references: [id], onDelete: Restrict)
  directReports   Employee[]        @relation("ReportingLine")
  membership      Membership?
  headOf          Department[]      @relation("DepartmentHead")
  leads           Team[]            @relation("TeamLeader")
  teamMemberships TeamMember[]
  events          EmploymentEvent[]

  tasksAssigned        Task[]        @relation("TaskAssignee")
  tasksReported        Task[]        @relation("TaskReporter")
  tasksToReview        Task[]        @relation("TaskReviewer")
  taskComments         TaskComment[]
  ownedLeads           Lead[]        @relation("LeadOwner")
  ownedCustomers       Customer[]    @relation("CustomerOwner")
  ownedContacts        Contact[]     @relation("ContactOwner")
  interactions         Interaction[]
  followUps            FollowUp[]
  dailyReports         DailyReport[] @relation("ReportAuthor")
  dailyReportsToReview DailyReport[] @relation("ReportReviewer")
  salesTargets         SalesTarget[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, workEmail])
  @@index([organizationId, departmentId])
  @@index([organizationId, managerId])
  @@index([organizationId, status])
  @@map("employees")
}

/// Effective-dated employment history (DOMAINS.md C-R5).
model EmploymentEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  type           String
  fromValue      Json?    @map("from_value")
  toValue        Json?    @map("to_value")
  effectiveDate  DateTime @map("effective_date") @db.Date
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, createdAt])
  @@map("employment_events")
}

/// Per-organization counters for human-readable codes (EMP-00042).
model OrgCounter {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  nextValue      Int    @default(1) @map("next_value")

  @@id([organizationId, key])
  @@map("org_counters")
}

/// Append-only audit trail (ADR-007). The app role has SELECT and INSERT only.
model AuditEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  /// user | system | platform_admin
  actorType      String        @default("user") @map("actor_type")
  category       AuditCategory
  action         String
  entityType     String        @map("entity_type")
  entityId       String?       @map("entity_id") @db.Uuid
  outcome        AuditOutcome  @default(success)
  correlationId  String?       @map("correlation_id")
  ip             String?
  userAgent      String?       @map("user_agent")
  /// Redacted change summary: { changes: { field: [before, after] }, ... }
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorUserId, createdAt])
  @@index([organizationId, category, createdAt])
  @@map("audit_events")
}

// ════════════════════════ Release 1: core operations and CRM ════════════════════════

enum Priority {
  low
  medium
  high
  urgent

  @@map("priority")
}

enum TaskStatus {
  todo
  in_progress
  in_review
  rework
  done
  cancelled

  @@map("task_status")
}

/// Fixed pipeline (ADR-020): reporting relies on stable stage meanings.
enum LeadStatus {
  new
  contacted
  qualified
  proposal
  negotiation
  won
  lost

  @@map("lead_status")
}

enum CustomerStatus {
  active
  inactive

  @@map("customer_status")
}

enum InteractionType {
  call
  email
  meeting
  message
  visit
  note

  @@map("interaction_type")
}

enum FollowUpType {
  call
  email
  meeting
  visit
  other

  @@map("follow_up_type")
}

enum FollowUpStatus {
  pending
  completed
  cancelled

  @@map("follow_up_status")
}

enum DailyReportStatus {
  draft
  submitted
  acknowledged
  clarification_requested

  @@map("daily_report_status")
}

// ───────────── Tasks ─────────────

model Task {
  id                 String     @id @default(uuid(7)) @db.Uuid
  organizationId     String     @map("organization_id") @db.Uuid
  code               String
  title              String
  description        String     @default("")
  status             TaskStatus @default(todo)
  priority           Priority   @default(medium)
  /// 0 to 100, maintained by the assignee.
  progress           Int        @default(0)
  dueAt              DateTime?  @map("due_at") @db.Timestamptz(3)
  assigneeEmployeeId String?    @map("assignee_employee_id") @db.Uuid
  reporterEmployeeId String     @map("reporter_employee_id") @db.Uuid
  /// Approves completion when review is required (defaults to the reporter).
  reviewerEmployeeId String?    @map("reviewer_employee_id") @db.Uuid
  requiresReview     Boolean    @default(true) @map("requires_review")
  leadId             String?    @map("lead_id") @db.Uuid
  customerId         String?    @map("customer_id") @db.Uuid
  startedAt          DateTime?  @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?  @map("completed_at") @db.Timestamptz(3)
  completedByUserId  String?    @map("completed_by_user_id") @db.Uuid
  overdueNotifiedAt  DateTime?  @map("overdue_notified_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  version            Int        @default(1)

  assignee Employee?     @relation("TaskAssignee", fields: [assigneeEmployeeId], references: [id], onDelete: Restrict)
  reporter Employee      @relation("TaskReporter", fields: [reporterEmployeeId], references: [id], onDelete: Restrict)
  reviewer Employee?     @relation("TaskReviewer", fields: [reviewerEmployeeId], references: [id], onDelete: Restrict)
  lead     Lead?         @relation(fields: [leadId], references: [id], onDelete: Restrict)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  comments TaskComment[]

  @@unique([organizationId, code])
  @@index([organizationId, assigneeEmployeeId, status])
  @@index([organizationId, reporterEmployeeId])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, leadId])
  @@index([status, dueAt])
  @@map("tasks")
}

model TaskComment {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  taskId           String   @map("task_id") @db.Uuid
  authorEmployeeId String   @map("author_employee_id") @db.Uuid
  body             String
  /// comment, review or rework
  kind             String   @default("comment")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Employee @relation(fields: [authorEmployeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, taskId, createdAt])
  @@map("task_comments")
}

/// Files attached to business records (DOMAINS.md L). Bytes live in object storage.
model Document {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  /// task, lead or customer
  entityType       String    @map("entity_type")
  entityId         String    @map("entity_id") @db.Uuid
  fileName         String    @map("file_name")
  contentType      String    @map("content_type")
  sizeBytes        Int       @map("size_bytes")
  sha256           String
  storageKey       String    @unique @map("storage_key")
  /// not_scanned until a malware scanner is integrated (risk R-10).
  scanStatus       String    @default("not_scanned") @map("scan_status")
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, entityType, entityId])
  @@map("documents")
}

// ───────────── CRM ─────────────

model Lead {
  id                String      @id @default(uuid(7)) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  code              String
  contactName       String      @map("contact_name")
  companyName       String      @default("") @map("company_name")
  /// Lower-cased.
  email             String?
  phone             String?
  /// Digits only, for duplicate detection.
  phoneNormalized   String?     @map("phone_normalized")
  source            String
  priority          Priority    @default(medium)
  status            LeadStatus  @default(new)
  ownerEmployeeId   String?     @map("owner_employee_id") @db.Uuid
  /// Integer minor units (paise, cents).
  estimatedValue    BigInt      @default(0) @map("estimated_value")
  currency          String      @db.Char(3)
  expectedCloseDate DateTime?   @map("expected_close_date") @db.Date
  notes             String      @default("")
  lostReason        String?     @map("lost_reason")
  lostNote          String?     @map("lost_note")
  /// Stage before lost, so a reopened lead returns where it was.
  statusBeforeLost  LeadStatus? @map("status_before_lost")
  customerId        String?     @map("customer_id") @db.Uuid
  contactId         String?     @map("contact_id") @db.Uuid
  wonAt             DateTime?   @map("won_at") @db.Timestamptz(3)
  lostAt            DateTime?   @map("lost_at") @db.Timestamptz(3)
  lastInteractionAt DateTime?   @map("last_interaction_at") @db.Timestamptz(3)
  nextFollowUpAt    DateTime?   @map("next_follow_up_at") @db.Timestamptz(3)
  createdByUserId   String      @map("created_by_user_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  version           Int         @default(1)

  owner        Employee?         @relation("LeadOwner", fields: [ownerEmployeeId], references: [id], onDelete: Restrict)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contact      Contact?          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  stageChanges LeadStageChange[]
  interactions Interaction[]
  followUps    FollowUp[]
  tasks        Task[]

  @@unique([organizationId, code])
  @@index([organizationId, ownerEmployeeId, status])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, email])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, customerId])
  @@map("leads")
}

model LeadStageChange {
  id              String      @id @default(uuid(7)) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  leadId          String      @map("lead_id") @db.Uuid
  fromStatus      LeadStatus? @map("from_status")
  toStatus        LeadStatus  @map("to_status")
  /// Owner at the time of the change, for attribution in performance metrics.
  ownerEmployeeId String?     @map("owner_employee_id") @db.Uuid
  actorUserId     String?     @map("actor_user_id") @db.Uuid
  changedAt       DateTime    @default(now()) @map("changed_at") @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, changedAt])
  @@index([organizationId, toStatus, changedAt])
  @@map("lead_stage_changes")
}

model Customer {
  id                String         @id @default(uuid(7)) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  code              String
  name              String
  /// Lower-cased, punctuation and legal suffixes removed: duplicate detection key.
  normalizedName    String         @map("normalized_name")
  website           String         @default("")
  industry          String         @default("")
  email             String?
  phone             String?
  phoneNormalized   String?        @map("phone_normalized")
  address           String         @default("")
  status            CustomerStatus @default(active)
  ownerEmployeeId   String?        @map("owner_employee_id") @db.Uuid
  createdFromLeadId String?        @map("created_from_lead_id") @db.Uuid
  lastInteractionAt DateTime?      @map("last_interaction_at") @db.Timestamptz(3)
  createdByUserId   String         @map("created_by_user_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  version           Int            @default(1)

  owner        Employee?     @relation("CustomerOwner", fields: [ownerEmployeeId], references: [id], onDelete: Restrict)
  contacts     Contact[]
  leads        Lead[]
  interactions Interaction[]
  followUps    FollowUp[]
  tasks        Task[]

  @@unique([organizationId, code])
  @@index([organizationId, normalizedName])
  @@index([organizationId, ownerEmployeeId])
  @@map("customers")
}

model Contact {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  customerId      String?  @map("customer_id") @db.Uuid
  firstName       String   @map("first_name")
  lastName        String   @default("") @map("last_name")
  /// Lower-cased; unique per organization when present.
  email           String?
  phone           String?
  phoneNormalized String?  @map("phone_normalized")
  jobTitle        String   @default("") @map("job_title")
  ownerEmployeeId String?  @map("owner_employee_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int      @default(1)

  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  owner        Employee?     @relation("ContactOwner", fields: [ownerEmployeeId], references: [id], onDelete: Restrict)
  leads        Lead[]
  interactions Interaction[]
  followUps    FollowUp[]

  @@unique([organizationId, email])
  @@index([organizationId, customerId])
  @@index([organizationId, phoneNormalized])
  @@map("contacts")
}

/// A logged customer touchpoint (call, email, meeting, message, visit) or a note.
model Interaction {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  type             InteractionType
  subject          String          @default("")
  body             String          @default("")
  outcome          String          @default("")
  occurredAt       DateTime        @map("occurred_at") @db.Timestamptz(3)
  durationMinutes  Int?            @map("duration_minutes")
  leadId           String?         @map("lead_id") @db.Uuid
  customerId       String?         @map("customer_id") @db.Uuid
  contactId        String?         @map("contact_id") @db.Uuid
  authorEmployeeId String          @map("author_employee_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  author   Employee  @relation(fields: [authorEmployeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, leadId, occurredAt])
  @@index([organizationId, customerId, occurredAt])
  @@index([organizationId, authorEmployeeId, occurredAt])
  @@map("interactions")
}

model FollowUp {
  id                 String         @id @default(uuid(7)) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  type               FollowUpType   @default(call)
  dueAt              DateTime       @map("due_at") @db.Timestamptz(3)
  note               String         @default("")
  status             FollowUpStatus @default(pending)
  assigneeEmployeeId String         @map("assignee_employee_id") @db.Uuid
  leadId             String?        @map("lead_id") @db.Uuid
  customerId         String?        @map("customer_id") @db.Uuid
  contactId          String?        @map("contact_id") @db.Uuid
  outcome            String         @default("")
  completedAt        DateTime?      @map("completed_at") @db.Timestamptz(3)
  completedByUserId  String?        @map("completed_by_user_id") @db.Uuid
  rescheduleCount    Int            @default(0) @map("reschedule_count")
  /// Set atomically when the reminder is sent: at most one reminder per due time.
  reminderSentAt     DateTime?      @map("reminder_sent_at") @db.Timestamptz(3)
  overdueNotifiedAt  DateTime?      @map("overdue_notified_at") @db.Timestamptz(3)
  createdByUserId    String         @map("created_by_user_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  version            Int            @default(1)

  assignee Employee  @relation(fields: [assigneeEmployeeId], references: [id], onDelete: Restrict)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@index([organizationId, assigneeEmployeeId, status, dueAt])
  @@index([organizationId, leadId])
  @@index([status, dueAt])
  @@map("follow_ups")
}

// ───────────── Activity, notifications, reports ─────────────

/// Transparent work-activity feed (ADR-021): business events only, each one visible to the
/// employee it concerns. Distinct from the governance audit trail.
model ActivityEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Employee whose work this is (usually the actor).
  employeeId     String   @map("employee_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  verb           String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  entityLabel    String   @default("") @map("entity_label")
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([organizationId, employeeId, occurredAt(sort: Desc)])
  @@index([organizationId, entityType, entityId, occurredAt])
  @@index([organizationId, verb, occurredAt])
  @@map("activity_events")
}

model Notification {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  recipientEmployeeId String    @map("recipient_employee_id") @db.Uuid
  type                String
  title               String
  body                String    @default("")
  entityType          String?   @map("entity_type")
  entityId            String?   @map("entity_id") @db.Uuid
  /// Idempotency: one notification per recipient and dedupe key.
  dedupeKey           String    @map("dedupe_key")
  readAt              DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, recipientEmployeeId, dedupeKey])
  @@index([organizationId, recipientEmployeeId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model DailyReport {
  id                 String            @id @default(uuid(7)) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  employeeId         String            @map("employee_id") @db.Uuid
  reportDate         DateTime          @map("report_date") @db.Date
  summary            String            @default("")
  blockers           String            @default("")
  notes              String            @default("")
  status             DailyReportStatus @default(draft)
  submittedAt        DateTime?         @map("submitted_at") @db.Timestamptz(3)
  late               Boolean           @default(false)
  reviewerEmployeeId String?           @map("reviewer_employee_id") @db.Uuid
  reviewedAt         DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reviewComment      String?           @map("review_comment")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  version            Int               @default(1)

  employee Employee          @relation("ReportAuthor", fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer Employee?         @relation("ReportReviewer", fields: [reviewerEmployeeId], references: [id], onDelete: Restrict)
  items    DailyReportItem[]

  @@unique([organizationId, employeeId, reportDate])
  @@index([organizationId, reportDate, status])
  @@index([organizationId, reviewerEmployeeId, status])
  @@map("daily_reports")
}

model DailyReportItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  reportId       String  @map("report_id") @db.Uuid
  /// task, interaction or other
  kind           String
  taskId         String? @map("task_id") @db.Uuid
  interactionId  String? @map("interaction_id") @db.Uuid
  description    String
  minutes        Int?
  sortOrder      Int     @default(0) @map("sort_order")

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([organizationId, reportId])
  @@map("daily_report_items")
}

/// Tenant-configurable value lists (lead sources, lost reasons, industries).
model PicklistValue {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  listKey        String   @map("list_key")
  key            String
  label          String
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, listKey, key])
  @@map("picklist_values")
}

/// Monthly sales target per employee (target progress on dashboards).
model SalesTarget {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  /// First day of the month.
  periodStart    DateTime @map("period_start") @db.Date
  wonValueTarget BigInt   @default(0) @map("won_value_target")
  wonCountTarget Int      @default(0) @map("won_count_target")
  setByUserId    String   @map("set_by_user_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, employeeId, periodStart])
  @@map("sales_targets")
}
